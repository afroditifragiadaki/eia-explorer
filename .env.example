# Copy to .env. Never commit it.
# Free key: https://www.eia.gov/opendata/
EIA_API_KEY=

# Turso (optional). Leave empty to use a local SQLite file in data/.
#   turso db create eia-explorer
#   turso db show eia-explorer --url
#   turso db tokens create eia-explorer
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: otherwise paste a key into the sidebar.
ANTHROPIC_API_KEY=

# API only: websites allowed to call the API from a browser (JSON list).
# Default: the React dev server on localhost:5173.
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example"]
